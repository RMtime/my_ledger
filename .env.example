# Persistent SQLite file. Mount its parent directory as a server volume.
DATABASE_PATH=./data/ledger.db
APP_ORIGIN=http://localhost:3000
APP_TIMEZONE=Asia/Hong_Kong
APP_BASE_CURRENCY=HKD

# Supabase Auth. Disable public registration in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
ALLOWED_AUTH_EMAIL=you@example.com

# Local-only development access. Never enable in production.
LOCAL_DEV_AUTH=true
LOCAL_DEV_OWNER_ID=00000000-0000-4000-8000-000000000001

# OpenAI-compatible provider. Leave empty to disable AI features.
AI_API_ENDPOINT=
AI_API_KEY=
AI_MODEL=
AI_DAILY_REPORT_LIMIT=5
