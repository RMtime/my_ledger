# Persistent SQLite file. Mount its parent directory as a server volume.
DATABASE_PATH=./data/ledger.db
# Pre-migration backups are created here before an existing schema is changed.
MIGRATION_BACKUP_DIR=./backups
APP_ORIGIN=http://localhost:3000
APP_TIMEZONE=Asia/Hong_Kong
APP_BASE_CURRENCY=HKD

# Supabase Auth. Disable public registration in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Comma-separated invite-only users. ALLOWED_AUTH_EMAIL remains a one-release fallback.
ALLOWED_AUTH_EMAILS=you@example.com,partner@example.com

# Local-only development access. Never enable in production.
LOCAL_DEV_AUTH=true
LOCAL_DEV_OWNER_ID=00000000-0000-4000-8000-000000000001

# AI providers are configured separately; users must opt in from settings.
DEEPSEEK_API_BASE_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
MINIMAX_API_BASE_URL=https://api.minimaxi.com/v1/chat/completions
MINIMAX_API_KEY=
MINIMAX_MODEL=
AI_DAILY_ATTEMPT_LIMIT=20
AI_DAILY_SUCCESS_LIMIT=10
AI_USER_CONCURRENCY=2
AI_GLOBAL_CONCURRENCY=4
HKMA_API_URL=https://api.hkma.gov.hk/public/market-data-and-statistics/monthly-statistical-bulletin/er-ir/er-eeri-daily
